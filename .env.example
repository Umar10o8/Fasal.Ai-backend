PORT=5000
NODE_ENV=development
# Neon: pooled URL (host contains "-pooler") for the app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon: direct URL (same, without "-pooler") for prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:5000"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://fasal-ai-lemon.vercel.app
# Local: FRONTEND_URL=http://localhost:5173
# Multiple: FRONTEND_URL=https://fasal-ai-lemon.vercel.app,http://localhost:5173
RESEND_API_KEY=
# Use a sender address on a domain verified in Resend for delivery to other recipients.
RESEND_FROM_EMAIL="FasalAI <onboarding@resend.dev>"
